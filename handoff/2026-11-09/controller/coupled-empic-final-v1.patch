+    end
+    r.intervals isa Vector{NamedTuple} && !isempty(r.intervals) && r.rejections isa Vector{NamedTuple} && r.decisions isa Vector{NamedTuple} || throw(ArgumentError("coupled trial history containers differ"))
+    isequal(phase.next_h,_ec_future_hint(phase,es.collection.schedule.control)) || throw(ArgumentError("coupled future interval hint differs from historical admission"))
+    length(r.intervals)+length(r.decisions)<=p.budget && _ec_report_cells(r)==r.costs.report_cells || throw(ArgumentError("coupled report event/cell bound differs"))
+    _ec_independent(_ec_role_arrays(r))
+    H=copy(r.initial_calendar.interval);a=deepcopy(r.initial_calendar.last);b=deepcopy(r.initial_calendar.next)
+    for i in eachindex(es.collection.mobile)
+        if r.step_before==0 || !es.collection.mobile[i]
+            _particle_stored_zero(H[i]) && iszero(a[i]) && iszero(b[i]) || throw(ArgumentError("coupled initial inactive calendar differs"))
+        else
+            H[i]>=2floatmin(T) && a[i]<=r.start<=b[i] && b[i]-a[i]==_exact_rational(H[i]) || throw(ArgumentError("coupled initial pending calendar differs"))
+        end
+    end
+    source,elapsed,clock_value=r.start,r.elapsed_before,r.public_before
