+    _ec_identical(shadow.configuration,_ec_configuration(es)) &&
+        isequal(shadow.clock,(es.time[],es.step[],es.last_dt[],es.last_sub_dt[])) &&
+        isequal(shadow.fields,_empic_event_fields(es)) && length(shadow.species)==length(shadow.bindings)==length(work.owners) ||
+        throw(ArgumentError("coupled source/configuration/physical field/clock changed; initialize full-time data"))
