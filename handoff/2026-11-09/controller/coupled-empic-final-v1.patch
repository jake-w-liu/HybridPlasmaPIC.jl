+        end
+        return _ec_publish!(es,work,phase,shadow;particles=true)
+    finally
+        _ec_release(schedule)
+    end
+end
+function _ec_closed(value,arrays=IdDict{Any,Bool}();depth=0)
+    # Schema4 has a fixed nonrecursive packet hierarchy;32 exceeds its actual
+    # stage/particle/cut nesting while bounding malformed input traversal.
+    depth<=32 || throw(ArgumentError("coupled receipt exceeds its closed schema nesting bound"))
+    if value===nothing || value isa Union{Bool,Symbol,String,Int,UInt64,UInt32,BigInt,CIC,TSC}
+        return nothing
+    elseif value isa _EMPICCoupledQ
+        _ec_q(value) || throw(ArgumentError("coupled exact numeric receipt is invalid"))
+    elseif value isa Union{Float32,Float64}
+        isfinite(value) || throw(ArgumentError("coupled numeric receipt is nonfinite"))
+    elseif value isa NamedTuple || value isa Tuple
+        foreach(entry -> _ec_closed(entry,arrays;depth=depth+1),value)
+    elseif value isa Array || value isa BitVector
+        haskey(arrays,value) && throw(ArgumentError("coupled receipt repeats an array role or contains a cycle"))
+        arrays[value]=true
+        all(i -> isassigned(value,i),eachindex(value)) || throw(ArgumentError("coupled receipt has unassigned entries"))
+        foreach(entry -> _ec_closed(entry,arrays;depth=depth+1),value)
+    else
+        throw(ArgumentError("coupled receipt contains an unsupported value type $(typeof(value))"))
+    end
+    return nothing
+end
+function _ec_snapshot_check(es,record)
+    T=eltype(es.rho_n);D=length(es.g.n)
+    record isa NamedTuple && keys(record)==(:species,:fields) && record.species isa Vector && length(record.species)==length(es.collection.mobile) || throw(ArgumentError("coupled stage snapshot layout differs"))
+    for ps in record.species
+        ps isa NamedTuple && keys(ps)==_CHECKPOINT_PARTICLE_FIELDS && ps.x isa NTuple{D,Vector{T}} &&
+            ps.v isa NTuple{3,Vector{T}} && ps.weight isa Vector{T} && ps.id isa Vector{UInt64} && ps.tag isa Vector{UInt32} && ps.q isa T && ps.m isa T ||
+            throw(ArgumentError("coupled stage particle record requires canonical ordinary vectors"))
+        count=length(ps.weight)
+        all(a -> axes(a,1)==Base.OneTo(count),(ps.x...,ps.v...,ps.weight,ps.id,ps.tag)) || throw(DimensionMismatch("coupled stage particle sizes differ"))
+    end
+    _validate_checkpoint_fields(record.fields,_empic_event_fields(es))
+    keys(record.fields)==keys(_empic_event_fields(es)) || throw(ArgumentError("coupled stage field inventory has extra fields"))
+    for value in values(record.fields),array in (value isa Tuple ? value : (value,))
+        array isa Array{T,D} && size(array)==es.g.n && all(isfinite,array) || throw(ArgumentError("coupled stage fields are invalid"))
+    end
+    populations=_ec_snapshot_populations(record,Val(D),T)
+    _empic_collection_validate_population_values(es,populations,es.c,es.relativistic)
+    return populations
+end
+function _ec_install_samples!(stage::EMPIC,ps,sample)
+    _ensure_empic_electron_buffers!(stage,nparticles(ps))
+    foreach(copyto!,stage.Ep,sample.E);foreach(copyto!,stage.Bp,sample.B)
+    return nothing
+end
+function _ec_install_samples!(stage::EMPIC1D,ps,sample)
+    _ensure_electron_buffers!(stage,nparticles(ps))
+    copyto!(stage.Exp,sample.E[1]);copyto!(stage.Eyp,sample.E[2]);copyto!(stage.Bzp,sample.B[3])
+    return nothing
+end
+function _ec_report_check(es,phase,species,fields,clock,meter;replay=true)
+    r=phase.report;T=eltype(es.rho_n);D=length(es.g.n)
+    r isa NamedTuple && keys(r)==_EC_REPORT_KEYS || throw(ArgumentError("coupled report has noncanonical fields"))
+    _ec_closed(r)
+    r.kind===(es isa EMPIC ? :vector : :planar) && _ec_identical(r.control,_ec_control(r.control,T)) &&
+        _ec_identical(r.control,phase.admission_control) && _ec_identical(r.configuration,_empic_event_configuration(es)) || throw(ArgumentError("coupled historical report policy/source differs"))
+    p=r.event_proposal
+    p isa NamedTuple && keys(p)==(:cap,:adaptive,:minimum,:limits,:budget) &&
+        p.cap isa Vector{T} && p.minimum isa Vector{T} && p.adaptive isa BitVector || throw(ArgumentError("coupled historical calendar proposal differs"))
+    _empic_event_proposal(es.collection.mobile,p.cap,p.adaptive,p.minimum,p.limits,p.budget,T)
+    r.n_sub isa Int && 1<=r.n_sub<=p.budget && r.requested isa T && r.requested>0 &&
+        r.public_before isa T && r.public_after isa T && r.public_before>=0 && r.public_after>r.public_before &&
+        r.step_before isa Int && r.step_after isa Int && 0<=r.step_before<r.step_after && r.step_after==Base.checked_add(r.step_before,1) &&
+        all(_ec_q,(r.start,r.finish,r.elapsed_before,r.elapsed_after,r.initial_energy,r.clock_defect)) &&
+        0<=r.start<r.finish && r.finish-r.start==_exact_rational(r.requested) && 0<=r.elapsed_before<r.elapsed_after || throw(ArgumentError("coupled report clocks differ"))
+    time,step,full,fast=clock
+    isequal((r.public_after,r.step_after,r.requested),(time,step,full)) && r.finish==phase.time && r.elapsed_after==phase.elapsed &&
+        r.initial_energy==phase.initial_energy || throw(ArgumentError("coupled report differs from complete phase"))
+    r.initial_calendar isa NamedTuple && keys(r.initial_calendar)==(:interval,:last,:next) &&
+        r.initial_calendar.interval isa Vector{T} && r.initial_calendar.last isa Vector{_EMPICCoupledQ} && r.initial_calendar.next isa Vector{_EMPICCoupledQ} &&
+        all(a -> axes(a,1)==Base.OneTo(length(species)),values(r.initial_calendar)) &&
+        r.initial_next_h isa T && r.control.h_min<=r.initial_next_h<=r.control.h_max || throw(ArgumentError("coupled report initial calendar/controller differs"))
+    for costs in (r.cost_before,r.costs,r.cost_after,r.admission_costs,r.verification_costs)
