+# Full-time coupled projected Euler/Heun control. Legacy half phases are separate.
+const _EMPICCoupledQ = Rational{BigInt}
+const _EC_CONTROL_KEYS = (:pair,:metric,:domain,:atol,:rtol,:h_min,:h_max,
+    :max_trials,:max_force_evals,:max_deposits,:max_fft_calls,:max_report_cells)
+const _EC_COST_KEYS = (:trials,:force_evals,:deposits,:fft_calls,:report_cells)
+const _EC_PHASE_KEYS = (:time,:elapsed,:interval,:last,:next,:next_h,:initial_energy,
+    :field_defect,:particle_defect,:coupling_defect,:admission_control,:costs,:report)
+struct _EMPICCoupledPhase{T}
+    time::_EMPICCoupledQ
+    elapsed::_EMPICCoupledQ
+    interval::Vector{T}
+    last::Vector{_EMPICCoupledQ}
+    next::Vector{_EMPICCoupledQ}
+    next_h::T
+    initial_energy::_EMPICCoupledQ
+    field_defect::_EMPICCoupledQ
+    particle_defect::_EMPICCoupledQ
+    coupling_defect::_EMPICCoupledQ
+    admission_control::NamedTuple
+    costs::NamedTuple
+    report::Union{Nothing,NamedTuple}
+end
+mutable struct _EMPICCoupledSchedule{T}
+    proposal::NamedTuple
+    control::NamedTuple
+    phase::_EMPICCoupledPhase{T}
+    candidate::_EMPICCoupledPhase{T}
+    shadow::Any
+    candidate_shadow::Any
+    signature::Union{Nothing,String}
+    busy::Threads.Atomic{Bool}
+end
+mutable struct _EMPICCoupledMeter
+    control::NamedTuple
+    trials::Int
+    force_evals::Int
+    deposits::Int
+    fft_calls::Int
+    report_cells::Int
+    continuity::Union{Nothing,NamedTuple}
+end
+struct _EMPICCoupledReject <: Exception
+    reason::Symbol
+    stage::Symbol
+    species::Int
+    particle::Int
+    defect::Union{Nothing,_EMPICCoupledQ}
+end
+Base.showerror(io::IO,e::_EMPICCoupledReject) = print(io,"coupled trial rejected: ",e.reason," at ",e.stage," species=",e.species," particle=",e.particle," defect=",e.defect)
+_ec_q(x) = x isa _EMPICCoupledQ && denominator(x) > 0
+function _ec_identical(left,right)
+    typeof(left)===typeof(right) || return false
+    if left isa NamedTuple || left isa Tuple
+        return length(left)==length(right) && all(pair -> _ec_identical(pair[1],pair[2]),zip(left,right))
+    elseif left isa AbstractArray
+        return axes(left)==axes(right) && all(pair -> _ec_identical(pair[1],pair[2]),zip(left,right))
+    end
+    return isequal(left,right)
+end
+_ec_zero_costs() = (trials=0,force_evals=0,deposits=0,fft_calls=0,report_cells=0)
+_ec_meter(control) = _EMPICCoupledMeter(control,0,0,0,0,0,nothing)
+_ec_costs(m::_EMPICCoupledMeter) = NamedTuple{_EC_COST_KEYS}(Tuple(getfield(m,k) for k in _EC_COST_KEYS))
+function _ec_costs_check(costs)
+    costs isa NamedTuple && keys(costs)==_EC_COST_KEYS && all(x -> x isa Int && x>=0,values(costs)) || throw(ArgumentError("coupled cost layout differs"))
+    return nothing
+end
+_ec_cost_add(a,b) = NamedTuple{_EC_COST_KEYS}(Tuple(Base.checked_add(getproperty(a,k),getproperty(b,k)) for k in _EC_COST_KEYS))
+_ec_cost_sub(a,b) = NamedTuple{_EC_COST_KEYS}(Tuple(getproperty(a,k)-getproperty(b,k) for k in _EC_COST_KEYS))
+function _ec_charge!(meter::_EMPICCoupledMeter,role::Symbol,count::Int)
+    count>=0 || throw(ArgumentError("coupled work charge must be nonnegative"))
+    role in _EC_COST_KEYS || throw(ArgumentError("unknown coupled work role"))
+    limit = getproperty(meter.control,Symbol("max_",role))
+    next = Base.checked_add(getfield(meter,role),count)
+    next<=limit || throw(ArgumentError("coupled $(role) work budget exhausted: required=$next, cap=$limit"))
+    setfield!(meter,role,next)
+    return nothing
+end
+_empic_fft_charge!(meter::_EMPICCoupledMeter,count::Int) = _ec_charge!(meter,:fft_calls,count)
+function _empic_continuity_observe!(meter::_EMPICCoupledMeter,absolute,scale)
+    meter.continuity = isfinite(absolute) && isfinite(scale) ?
+        (absolute=_exact_rational(absolute),scale=_exact_rational(scale)) : nothing
+    return nothing
+end
+_ec_reject(reason,stage,s=0,p=0,defect=nothing) = throw(_EMPICCoupledReject(reason,stage,s,p,defect))
+function _ec_mode(::Type{T}) where {T}
+    rounding(T)===RoundNearest && rounding(Float64)===RoundNearest && !get_zero_subnormals() || throw(ArgumentError("coupled control requires nearest rounding and gradual underflow"))
+    return nothing
+end
+function _ec_control(proposal,::Type{T}) where {T}
+    proposal isa NamedTuple && keys(proposal)==_EC_CONTROL_KEYS || throw(ArgumentError("coupled error_control requires the closed projected-pair proposal"))
+    proposal.pair===:projected_euler_heun_v1 && proposal.metric===:component_max_v1 && proposal.domain===:cic_tsc_continuous_v1 || throw(ArgumentError("unsupported coupled pair/metric/domain"))
+    roles=(:x,:v,:E,:B,:clock)
+    for name in (:atol,:rtol)
+        record=getproperty(proposal,name)
+        record isa NamedTuple && keys(record)==roles || throw(ArgumentError("coupled tolerances require x/v/E/B/clock roles"))
+    end
+    atols=NamedTuple{roles}(map(values(proposal.atol)) do v
+        result=_empic_event_scalar("coupled absolute tolerance",v,T)
+        _stored_positive(result) || throw(ArgumentError("coupled absolute tolerances must be positive"))
+        result
+    end)
+    rtols=NamedTuple{roles}(map(values(proposal.rtol)) do v
+        result=_empic_event_scalar("coupled relative tolerance",v,T)
+        _stored_nonnegative(result) && result<one(T) || throw(ArgumentError("coupled relative tolerances must be in[0,1)"))
+        result
+    end)
+    minimum=_empic_event_scalar("coupled h_min",proposal.h_min,T)
+    maximum=_empic_event_scalar("coupled h_max",proposal.h_max,T)
+    0<minimum<=maximum || throw(ArgumentError("coupled interval bounds must be positive and ordered"))
+    _require_resolved_dt("coupled h_min",minimum);_require_resolved_dt("coupled h_max",maximum)
+    names=(:max_trials,:max_force_evals,:max_deposits,:max_fft_calls,:max_report_cells)
+    limits=NamedTuple{names}(map(names) do name
+        v=getproperty(proposal,name)
+        v isa Integer && !(v isa Bool) && 1<=v<=typemax(Int) || throw(ArgumentError("coupled work caps must be positive fitting Int values"))
+        Int(v)
+    end)
+    return merge((pair=proposal.pair,metric=proposal.metric,domain=proposal.domain,atol=atols,rtol=rtols,h_min=minimum,h_max=maximum),limits)
+end
+function _ec_zero_phase(::Type{T},count,control;energy=zero(_EMPICCoupledQ),costs=_ec_zero_costs()) where {T}
+    z=zero(_EMPICCoupledQ)
+    return _EMPICCoupledPhase{T}(z,z,zeros(T,count),fill(z,count),fill(z,count),control.h_max,energy,z,z,z,control,costs,nothing)
+end
+function _empic_coupled_schedule(mobile,ns,stride,cap,adaptive,minimum,limits,budget,::Type{T},control) where {T}
+    cap===nothing && throw(ArgumentError("coupled error control requires species_dt and event_budget at construction"))
+    stride===nothing || throw(ArgumentError("coupled control cannot use species_stride"))
+    proposal=_empic_event_proposal(mobile,cap,adaptive,minimum,limits,budget,T)
+    ns<=proposal.budget || throw(ArgumentError("base field partition exceeds coupled event budget"))
+    closed=_ec_control(control,T);phase=_ec_zero_phase(T,length(mobile),closed)
+    return _EMPICCoupledSchedule{T}(proposal,closed,phase,_ec_zero_phase(T,length(mobile),closed),nothing,nothing,nothing,Threads.Atomic{Bool}(false))
+end
+_empic_coupled_bind!(es,schedule) = nothing
+function _ec_spectral_signature(g)
+    expected=SpectralOperators._fourier_metadata(g.n,g.L)
+    for role in (:n,:L,:dx,:midx,:kfull,:ik,:kvec)
+        isequal(getproperty(g,role),getproperty(expected,role)) || throw(ArgumentError("coupled Fourier metadata is not canonical"))
+    end
+    bytes=UInt8[]
+    for vector in (collect(g.n),collect(g.L),collect(g.dx),g.midx...,g.kfull...,g.ik...,g.kvec...)
+        append!(bytes,reinterpret(UInt8,vector))
+    end
+    return bytes2hex(SHA.sha256(bytes))
+end
+function _empic_coupled_bind!(es,schedule::_EMPICCoupledSchedule)
+    schedule.signature=_ec_spectral_signature(es.g)
+    return nothing
+end
+function _ec_acquire(schedule)
+    Threads.atomic_cas!(schedule.busy,false,true)==false || throw(ArgumentError("coupled EMPIC already has an active operation"))
+    return nothing
+end
+_ec_release(schedule) = (Threads.atomic_xchg!(schedule.busy,false);nothing)
+function _ec_copy_fields(fields)
+    return NamedTuple{keys(fields)}(map(v -> v isa Tuple ? map(copy,v) : copy(v),values(fields)))
+end
+function _ec_copy_species(species,::Val{D},::Type{T}) where {D,T}
+    result=_ElectrostaticHostParticle{D,T}[]
+    _pic_prepare_species_stages!(result,species)
+    return result
+end
+function _ec_new_stage(es::EMPIC{D,T};c=es.c,shape=es.shape,relativistic=es.relativistic,n_sub=es.n_sub) where {D,T}
+    return _new_empic_state(es.g,0,es.n0,c,shape,relativistic,false,one(T),n_sub,nothing)
+end
+function _ec_new_stage(es::EMPIC1D{T};c=es.c,shape=es.shape,relativistic=es.relativistic,n_sub=es.n_sub) where {T}
+    return _new_empic1d_state(es.g,0,es.n0,c,shape,relativistic,false,one(T),n_sub,nothing)
+end
+function _ec_restore_fields!(stage,fields)
+    _restore_checkpoint_fields!(_empic_event_fields(stage),fields)
+    return stage
+end
+function _ec_snapshot(stage,species)
+    return (species=NamedTuple[deepcopy(_checkpoint_particle_state(ps)) for ps in species],fields=_ec_copy_fields(_empic_event_fields(stage)))
+end
+_ec_snapshot_populations(record,::Val{D},::Type{T}) where {D,T} = _ElectrostaticHostParticle{D,T}[_checkpoint_species(ps,Val(D),T) for ps in record.species]
+function _ec_energy(stage,species)
+    U=_empic_event_energy(stage)
+    K=if stage.relativistic
+        value=first(_relativistic_particle_moments(species,stage.c))
+        isfinite(value) || throw(ArgumentError("coupled reported relativistic kinetic energy is nonfinite"))
+        _exact_rational(value)
+    else
+        _kinetic_energy_rational(species)
+    end
+    return K,U
+end
+function _ec_count_particles(species,mobile=nothing)
+    count=0
+    for (i,ps) in enumerate(species)
+        mobile===nothing || mobile[i] || continue
+        count=Base.checked_add(count,nparticles(ps))
+    end
+    return count
+end
+function _ec_source!(rho,stage,species,target,meter)
+    _ec_charge!(meter,:deposits,_ec_count_particles(species))
+    return _empic_charge_sum!(rho,stage.ne,species,stage.g,stage.shape,stage.n0,target)
+end
+function _ec_current!(stage::EMPIC,species,mobile,meter)
+    _ec_charge!(meter,:deposits,Base.checked_mul(3,_ec_count_particles(species,mobile)))
+    midpoints=[map(_ -> eltype(stage.rho_n)[],ps.x) for ps in species]
+    _empic_current_sum!(stage.Jraw,(work=stage.worke,density=stage.ne),species,midpoints,mobile,stage.g,stage.shape,Val(:stored_positions))
+    return (current=map(copy,stage.Jraw),dc=nothing)
+end
+function _ec_current!(stage::EMPIC1D{T},species,mobile,meter) where {T}
+    _ec_charge!(meter,:deposits,Base.checked_mul(2,_ec_count_particles(species,mobile)))
+    Jy=similar(stage.Jy)
+    _empic_exact_current_sum!(Jy,species,fill(nothing,length(species)),mobile,stage.g,stage.shape,2,Val(:stored_positions))
