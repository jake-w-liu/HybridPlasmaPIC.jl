+        count=Base.checked_add(count,length(array))
+    end
+    return count
+end
+function _empic_collection_schedule_arrays(schedule::_EMPICCoupledSchedule)
+    arrays=AbstractArray[schedule.proposal.cap,schedule.proposal.adaptive,schedule.proposal.minimum]
+    for phase in (schedule.phase,schedule.candidate)
+        append!(arrays,(phase.interval,phase.last,phase.next))
+        append!(arrays,_ec_role_arrays(phase.report))
+    end
+    append!(arrays,_empic_event_shadow_arrays(schedule.shadow))
+    append!(arrays,_empic_event_shadow_arrays(schedule.candidate_shadow))
+    return arrays
+end
+_empic_collection_schedule_axes(::_EMPICCoupledSchedule,array,count) = nothing
+function _empic_collection_validate_schedule(es,schedule::_EMPICCoupledSchedule{T}) where {T}
+    _ec_mode(T)
+    es.shape isa Union{CIC,TSC} || throw(ArgumentError("coupled error control admits CIC/TSC only"))
+    _ec_identical(schedule.control,_ec_control(schedule.control,T)) || throw(ArgumentError("coupled control representation changed"))
+    p=schedule.proposal
+    _ec_identical(p,_empic_event_proposal(es.collection.mobile,p.cap,p.adaptive,p.minimum,p.limits,p.budget,T)) || throw(ArgumentError("coupled nominal proposal representation changed"))
+    es.n_sub isa Int && 1<=es.n_sub<=p.budget || throw(ArgumentError("coupled base/event budget differs"))
+    schedule.signature isa String && schedule.signature==_ec_spectral_signature(es.g) || throw(ArgumentError("coupled spectral symbol changed"))
+    for phase in (schedule.phase,schedule.candidate)
+        all(a -> axes(a,1)==Base.OneTo(length(es.collection.mobile)),(phase.interval,phase.last,phase.next)) || throw(ArgumentError("coupled calendar row layout changed"))
+        phase.report===nothing || phase.report isa NamedTuple || throw(ArgumentError("coupled report container differs"))
+    end
+    return nothing
+end
+function _ec_configuration(es;proposal=es.collection.schedule.proposal,control=es.collection.schedule.control,
+    n_sub=es.n_sub,c=es.c,relativistic=es.relativistic,signature=es.collection.schedule.signature)
+    return merge(_empic_event_configuration(es;c,relativistic),
