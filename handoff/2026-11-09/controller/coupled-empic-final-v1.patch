+                end
+            end
+            @test isapprox(es.rho_np1,reference.rho_high;rtol=tolerance,atol=tolerance)
+            @test maximum(a->maximum(abs,a),reference.longitudinal)>1e-12
+            # Removing G(rhoH-rhoE) cannot satisfy this actual branch comparison.
+            lowE=es isa EMPIC ? interval.low.fields.E : (interval.low.fields.Ex,interval.low.fields.Ey,zeros(T,es.g.n))
+            highE=es isa EMPIC ? interval.high.fields.E : (interval.high.fields.Ex,interval.high.fields.Ey,zeros(T,es.g.n))
+            for c=1:3
+                @test isapprox(Float64.(highE[c]).-Float64.(lowE[c]),Float64.(reference.E_high[c]).-Float64.(reference.E_low[c]);rtol=tolerance,atol=tolerance)
+            end
+            @test (es isa EMPIC ? r.work_raw!==nothing && r.work_raw_transverse===nothing : r.work_raw===nothing && r.work_raw_transverse!==nothing)
+            @test r.total_defect==r.field_defect+r.particle_defect+r.coupling_defect
+            @test r.total_defect==r.field_after-r.field_before+r.kinetic_after-r.kinetic_before
+            # Actual effective-symbol null modes are distinct from physical DC.
+            hats=map(a->dft(a,es.g),current);dc=first(CartesianIndices(es.g.n))
+            for I in CartesianIndices(es.g.n)
+                if I!=dc && iszero(sum(abs2,wavevector(es.g,I)))
