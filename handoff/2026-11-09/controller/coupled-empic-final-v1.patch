+end
+function _ec_phase_scalar_check(es,phase,population_count::Int,initialized,clock)
+    T=eltype(es.rho_n);time,step,full,fast=clock
+    phase isa _EMPICCoupledPhase{T} && initialized isa Bool || throw(ArgumentError("coupled phase type differs"))
+    _validate_empic_clock_phase(time,step,full,fast)
+    all(_ec_q,(phase.time,phase.elapsed,phase.initial_energy,phase.field_defect,phase.particle_defect,phase.coupling_defect,phase.last...,phase.next...)) &&
+        phase.time>=0 && phase.elapsed>=0 && phase.initial_energy>=0 && isfinite(phase.next_h) && _stored_positive(phase.next_h) || throw(ArgumentError("coupled phase exact scalars differ"))
+    _require_resolved_dt("coupled next interval",phase.next_h);_ec_costs_check(phase.costs)
