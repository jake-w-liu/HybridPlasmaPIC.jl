+    dc=_empic1d_collection_Jx0(stage,(staged=species,mobile=mobile))
+    return (current=(Jy,),dc=dc)
+end
+function _ec_average_current(a,b,::Type{T}) where {T}
+    current=map(a.current,b.current) do left,right
+        map((x,y) -> _from_exact(T,(_exact_rational(x)+_exact_rational(y))/2),left,right)
+    end
+    dc=a.dc===nothing ? nothing : _from_exact(T,(_exact_rational(a.dc)+_exact_rational(b.dc))/2)
+    all(x -> all(isfinite,x),current) && (dc===nothing || isfinite(dc)) || throw(ArgumentError("coupled averaged current is nonfinite"))
+    return (current=current,dc=dc)
+end
+function _ec_correct!(stage::EMPIC,raw,h,meter,which)
+    foreach(copyto!,stage.Jraw,raw.current)
+    _empic_correct_current!(stage.J,stage.Jraw,stage.rho_n,stage.rho_np1,stage.g,h,meter)
+    all(a -> all(isfinite,a),stage.J) || _ec_reject(:nonfinite_current,which)
+    return nothing
+end
+function _ec_correct!(stage::EMPIC1D,raw,h,meter,which)
+    copyto!(stage.Jy,only(raw.current));_zero_nyquist_mode!(stage.Jy)
+    _esirkepov_Jx!(stage,raw.dc,h,meter)
+    all(a -> all(isfinite,a),(stage.Jx,stage.Jy)) || _ec_reject(:nonfinite_current,which)
+    return nothing
+end
+function _ec_force!(stage,species,mobile,H,meter)
+    rows=Union{Nothing,NamedTuple}[]
+    for (i,ps) in enumerate(species)
+        if !mobile[i]
+            push!(rows,nothing);continue
+        end
+        _ec_charge!(meter,:force_evals,nparticles(ps))
+        _empic_collection_gather!(stage,ps;initial=true)
+        T=eltype(ps)
+        E,B=if stage isa EMPIC
+            map(copy,stage.Ep),map(copy,stage.Bp)
+        else
+            ((copy(stage.Exp),copy(stage.Eyp),zeros(T,nparticles(ps))),
+                (zeros(T,nparticles(ps)),zeros(T,nparticles(ps)),copy(stage.Bzp)))
+        end
+        all(a -> all(isfinite,a),(E...,B...)) || _ec_reject(:nonfinite_gather,:force,i)
+        factor=_validated_boris_factor(ps)
+        increments=NamedTuple[_em_lorentz_scaled_parts(ntuple(c -> ps.v[c][p],3),ntuple(c -> E[c][p],3),
+            ntuple(c -> B[c][p],3),factor,H,stage.c,Val(stage.relativistic)) for p in eachindex(ps.weight)]
+        push!(rows,(E=E,B=B,increments=increments))
+    end
+    return rows
+end
+function _ec_parts(derivative,parts)
+    if parts===nothing
+        all(isfinite,derivative) || _ec_reject(:nonfinite_derivative,:field)
+        return [(copy(derivative),one(_EMPICCoupledQ))]
+    end
+    all(pair -> all(isfinite,first(pair)),parts) || _ec_reject(:nonfinite_derivative,:field)
+    return [(copy(array),scale) for (array,scale) in parts]
+end
+function _ec_derivatives!(stage::EMPIC,meter)
+    ep=_em_curl_parts!(stage.curlE,stage.E,stage.g,meter)
+    bp=_em_curl_parts!(stage.curlB,stage.B,stage.g,meter)
+    return (electric=ntuple(c -> _ec_parts(stage.curlE[c],ep===nothing ? nothing : ep[c]),3),
+        magnetic=ntuple(c -> _ec_parts(stage.curlB[c],bp===nothing ? nothing : bp[c]),3))
+end
+function _ec_derivatives!(stage::EMPIC1D{T},meter) where {T}
+    ep=_em_derivative_parts!(stage.dEy,stage.Ey,stage.g,1,meter)
+    bp=_em_derivative_parts!(stage.dBz,stage.Bz,stage.g,1,meter)
+    electric=(_ec_parts(stage.dEy,ep),)
+    transverse=[(array,-scale) for (array,scale) in _ec_parts(stage.dBz,bp)]
+    longitudinal=Tuple{Array{T,1},_EMPICCoupledQ}[]
+    return (electric=electric,magnetic=(longitudinal,transverse))
+end
+function _ec_cut_receipt(x,y,L,dx,shape)
+    Q=_exact_rational;period=Q(L);spacing=Q(dx)
+    iszero(y-x) && return (direction=0,seam=false,segments=())
+    direction=y>x ? 1 : -1
+    parameters=_EMPICCoupledQ[0,1]
+    first_plane=ceil(BigInt,min(x,y)/period)
+    last_plane=floor(BigInt,max(x,y)/period)
+    last_plane-first_plane<=1 || throw(ArgumentError("coupled branch crossed its admitted travel range"))
+    for plane=first_plane:last_plane
+        boundary=plane*period
+        theta=(boundary-x)/(y-x)
+        0<theta<1 && push!(parameters,theta)
+    end
+    sort!(unique!(parameters))
+    offset=shape isa CIC ? zero(_EMPICCoupledQ) : BigInt(1)//BigInt(2)
+    pieces=NamedTuple[]
+    for j=1:length(parameters)-1
+        a,b=parameters[j],parameters[j+1]
+        tile=floor(BigInt,(x+(a+b)*(y-x)/2)/period)
+        left=x+a*(y-x)-tile*period;right=x+b*(y-x)-tile*period
+        first=ceil(BigInt,min(left,right)/spacing-offset)
+        last=floor(BigInt,max(left,right)/spacing-offset)
+        push!(pieces,(tile=tile,start=left,finish=right,first=first,last=last,offset=offset))
+    end
+    return (direction=direction,seam=floor(BigInt,x/period)!=floor(BigInt,y/period),segments=Tuple(pieces))
+end
+function _ec_stencil_receipt(ps,g,shape)
+    D=length(g.n)
+    return [ntuple(d -> begin
+        coordinate=_particle_cell_position(ps,g,d,p)
+        base,weights=_stencil1d(shape,coordinate)
+        (coordinate=coordinate,base=base,weights=weights)
+    end,D) for p in eachindex(ps.weight)]
+end
+function _ec_particle_branch!(destination,origin,euler,forces0,forces1,stage,mobile,h,which)
+    T=eltype(stage.rho_n);D=length(stage.g.n);H=_exact_rational(h)
+    rows=Union{Nothing,NamedTuple}[]
+    for (s,(before,after)) in enumerate(zip(origin,destination))
+        if !mobile[s]
+            push!(rows,nothing);continue
+        end
+        n=nparticles(before)
+        ideal=ntuple(_ -> Vector{_EMPICCoupledQ}(undef,n),D)
+        lifted=ntuple(_ -> Vector{_EMPICCoupledQ}(undef,n),D)
+        winding=ntuple(_ -> Vector{BigInt}(undef,n),D)
+        defect=ntuple(_ -> Vector{_EMPICCoupledQ}(undef,n),D)
+        wrapped=ntuple(_ -> Vector{T}(undef,n),D)
+        cuts=Vector{NTuple{D,NamedTuple}}(undef,n)
+        for p in eachindex(before.weight)
+            v0=ntuple(c -> before.v[c][p],3)
+            p1=forces1===nothing ? nothing : forces1[s].increments[p]
+            output=_em_lorentz_pair_output(v0,forces0[s].increments[p],p1,stage.c,Val(stage.relativistic))
+            all(isfinite,output) || _ec_reject(:nonfinite_velocity,which,s,p)
+            stage.relativistic && !_supported_relativistic_output(output,stage.c) && _ec_reject(:unsupported_velocity,which,s,p)
+            for c=1:3
+                after.v[c][p]=output[c]
+            end
+            for d=1:D
+                x=_exact_rational(before.x[d][p])
+                velocity=forces1===nothing ? _exact_rational(v0[d]) :
+                    (_exact_rational(v0[d])+_exact_rational(euler[s].v[d][p]))/2
+                target=_particle_coordinate(x,velocity,H)
+                represented=_periodic_represented_lift(target,stage.g.L[d])
+                bound=_exact_rational(stage.g.L[d])/4
+                max(abs(target-x),abs(represented.lifted-x))<bound || _ec_reject(:travel,which,s,p,max(abs(target-x),abs(represented.lifted-x))/bound)
+                after.x[d][p]=represented.wrapped
+                ideal[d][p],lifted[d][p]=target,represented.lifted
+                winding[d][p],defect[d][p],wrapped[d][p]=represented.winding,represented.defect,represented.wrapped
+            end
+            cuts[p]=ntuple(d -> _ec_cut_receipt(_exact_rational(before.x[d][p]),lifted[d][p],stage.g.L[d],stage.g.dx[d],stage.shape),D)
+        end
+        push!(rows,(ideal=ideal,lifted=lifted,winding=winding,defect=defect,wrapped=wrapped,cuts=cuts,
+            stencil=_ec_stencil_receipt(after,stage.g,stage.shape)))
+    end
+    return rows
+end
+function _ec_constraint(stage,meter)
+    T=eltype(stage.rho_n)
+    E=stage isa EMPIC ? stage.E : (stage.Ex,stage.Ey)
+    B=stage isa EMPIC ? stage.B : (stage.Bz,)
+    projectedE=stage isa EMPIC ? map(copy,E) : (copy(stage.Ex),copy(stage.Ey),zeros(T,stage.g.n))
+    projectedB=stage isa EMPIC ? map(copy,B) : (zeros(T,stage.g.n),zeros(T,stage.g.n),copy(stage.Bz))
+    _empic_fft_charge!(meter,7)
+    _spectral_divergence_project!(projectedE,stage.rho_np1,stage.g)
+    _empic_fft_charge!(meter,6)
+    _spectral_divergence_project!(projectedB,nothing,stage.g)
+    e=ntuple(c -> map((a,b) -> _exact_rational(a)-_exact_rational(b),projectedE[c],E[c]),length(E))
+    b=ntuple(c -> begin
+        projected=stage isa EMPIC ? projectedB[c] : projectedB[3]
+        map((a,x) -> _exact_rational(a)-_exact_rational(x),projected,B[c])
+    end,length(B))
+    return (electric=e,magnetic=b)
+end
+function _ec_component_norm(difference,start,low,high,absolute,relative)
+    result=zero(_EMPICCoupledQ)
+    for i in eachindex(difference)
+        scale=_exact_rational(absolute)+_exact_rational(relative)*max(abs(_exact_rational(start[i])),abs(_exact_rational(low[i])),abs(_exact_rational(high[i])))
+        result=max(result,abs(difference[i])/scale)
+    end
+    return result
+end
+function _ec_field_norm(difference,start,low,high,control,role)
+    result=zero(_EMPICCoupledQ)
+    for c in eachindex(difference)
+        result=max(result,_ec_component_norm(difference[c],start[c],low[c],high[c],getproperty(control.atol,role),getproperty(control.rtol,role)))
+    end
+    return result
+end
+function _ec_observed_constraint_norm(constraint,origin,low,high,control)
+    E0=_empic_event_field_E(low,origin)
+    B0=_empic_event_field_B(low,origin)
+    return (electric=_ec_field_norm(constraint.electric,E0,_empic_event_E(low),_empic_event_E(high),control,:E),
+        magnetic=_ec_field_norm(constraint.magnetic,B0,_empic_event_B(low),_empic_event_B(high),control,:B))
+end
+function _ec_particle_norm(origin,low,high,lifts,mobile,g,control)
+    position,velocity=zero(_EMPICCoupledQ),zero(_EMPICCoupledQ)
+    for (s,(before,left,right)) in enumerate(zip(origin,low,high))
+        mobile[s] || continue
+        for p in eachindex(before.weight)
+            for d in eachindex(before.x)
+                delta=lifts.high[s].lifted[d][p]-lifts.low[s].lifted[d][p]
+                abs(delta)<_exact_rational(g.L[d])/2 || _ec_reject(:ambiguous_position,:pair,s,p)
+                position=max(position,abs(delta)/(_exact_rational(control.atol.x)+_exact_rational(control.rtol.x)*_exact_rational(g.L[d])))
+            end
+            for c=1:3
+                scale=_exact_rational(control.atol.v)+_exact_rational(control.rtol.v)*max(abs(_exact_rational(before.v[c][p])),abs(_exact_rational(left.v[c][p])),abs(_exact_rational(right.v[c][p])))
+                velocity=max(velocity,abs(_exact_rational(right.v[c][p])-_exact_rational(left.v[c][p]))/scale)
+            end
+        end
+    end
+    return position,velocity
+end
+function _ec_row_receipts(origin,out,stages,weights,h)
+    H=_exact_rational(h);c2=_exact_rational(out.c)^2
+    E0,B0=_empic_event_field_E(out,origin),_empic_event_field_B(out,origin)
+    E,B,J=_empic_event_E(out),_empic_event_B(out),_empic_event_J(out)
+    etaE=ntuple(length(E)) do c
+        parts=_empic_weighted_derivative(stages,weights,:magnetic,c)
+        result=similar(E[c],_EMPICCoupledQ)
+        for i in eachindex(result)
+            result[i]=_exact_rational(E[c][i])-_exact_rational(E0[c][i])-H*c2*_em_exact_derivative(parts,i)+H*_exact_rational(J[c][i])
+        end
+        result
+    end
+    etaB=ntuple(length(B)) do c
+        parts=_empic_weighted_derivative(stages,weights,:electric,c)
+        result=similar(B[c],_EMPICCoupledQ)
+        for i in eachindex(result)
+            result[i]=_exact_rational(B[c][i])-_exact_rational(B0[c][i])+H*_em_exact_derivative(parts,i)
+        end
+        result
+    end
+    return (electric=etaE,magnetic=etaB)
+end
+function _ec_continuity(stage,h,meter)
+    meter.continuity=nothing
+    relative=charge_conservation_residual(stage,h,meter)
+    isfinite(relative) && relative>=0 && meter.continuity!==nothing || _ec_reject(:unresolved_continuity,:field)
+    return merge((relative=relative,),meter.continuity)
+end
+function _ec_stage_power(species,forces,mobile)
+    result=zero(_EMPICCoupledQ)
+    for (s,ps) in enumerate(species)
+        mobile[s] || continue
+        for p in eachindex(ps.weight)
+            result+=_exact_rational(ps.q)*_exact_rational(ps.weight[p])*
+                sum(c -> _exact_rational(ps.v[c][p])*_exact_rational(forces[s].E[c][p]),1:3)
+        end
+    end
+    return result
+end
+function _ec_interval_work(stage,origin_species,low_species,high_species,origin_fields,forces0,forces1,raw,h,mobile)
+    H=_exact_rational(h);volume=prod(_exact_rational,stage.g.dx)
+    E0=_empic_event_field_E(stage,origin_fields);E1=_empic_event_E(stage);J=_empic_event_J(stage)
+    used=volume*H*sum(c -> sum(i -> _exact_rational(J[c][i])*(_exact_rational(E0[c][i])+_exact_rational(E1[c][i]))/2,eachindex(J[c]);init=zero(_EMPICCoupledQ)),eachindex(J);init=zero(_EMPICCoupledQ))
+    rawwork=if stage isa EMPIC
+        volume*H*sum(c -> sum(i -> _exact_rational(raw.current[c][i])*(_exact_rational(E0[c][i])+_exact_rational(E1[c][i]))/2,eachindex(raw.current[c]);init=zero(_EMPICCoupledQ)),eachindex(raw.current);init=zero(_EMPICCoupledQ))
+    else
+        volume*H*sum(i -> _exact_rational(only(raw.current)[i])*(_exact_rational(E0[2][i])+_exact_rational(E1[2][i]))/2,eachindex(stage.Jy);init=zero(_EMPICCoupledQ))
+    end
+    particle=H*(_ec_stage_power(origin_species,forces0,mobile)+_ec_stage_power(low_species,forces1,mobile))/2
+    K1,U1=_ec_energy(stage,high_species)
+    K0=stage.relativistic ? begin
+        value=first(_relativistic_particle_moments(origin_species,stage.c))
+        isfinite(value) || throw(ArgumentError("coupled initial reported kinetic energy is nonfinite"))
+        _exact_rational(value)
+    end : _kinetic_energy_rational(origin_species)
+    U0=_field_energy_rational(E0,_empic_event_field_B(stage,origin_fields),_exact_rational(stage.c)^2,stage.g.dx)
+    df,dp,dc=U1-U0+used,K1-K0-particle,particle-used
+    return (work_used=used,work_raw=stage isa EMPIC ? rawwork : nothing,
+        work_raw_transverse=stage isa EMPIC1D ? rawwork : nothing,particle_work=particle,
+        field_before=U0,field_after=U1,kinetic_before=K0,kinetic_after=K1,
+        field_defect=df,particle_defect=dp,coupling_defect=dc,total_defect=U1-U0+K1-K0)
+end
+function _ec_pair!(stage,origin_species,origin_fields,mobile,target,h,delta,time,next_time,source,elapsed,control,meter)
+    T=eltype(stage.rho_n);D=length(stage.g.n);H=_exact_rational(h)
+    before_cost=_ec_costs(meter);_ec_charge!(meter,:trials,1)
+    _ec_restore_fields!(stage,origin_fields)
+    rho0=similar(stage.rho_n);_ec_source!(rho0,stage,origin_species,target,meter)
+    isequal(rho0,origin_fields.rho_np1) || throw(ArgumentError("coupled origin charge differs from its committed source"))
+    force0=_ec_force!(stage,origin_species,mobile,H,meter)
+    raw0=_ec_current!(stage,origin_species,mobile,meter)
+    derivatives0=_ec_derivatives!(stage,meter)
+    low=_ec_new_stage(stage);_ec_restore_fields!(low,origin_fields)
+    low_species=_ec_copy_species(origin_species,Val(D),T)
+    low_lift=_ec_particle_branch!(low_species,origin_species,nothing,force0,nothing,stage,mobile,h,:low)
+    copyto!(low.rho_n,rho0);_ec_source!(low.rho_np1,low,low_species,target,meter)
+    _ec_correct!(low,raw0,h,meter,:low)
+    _empic_full_time_field_update!(low,origin_fields,(derivatives0,),(one(_EMPICCoupledQ),),h)
+    all(a -> all(isfinite,a),(_empic_event_E(low)...,_empic_event_B(low)...,_empic_event_J(low)...)) || _ec_reject(:nonfinite_field,:low)
+    constraint_low=_ec_constraint(low,meter)
+    cl=_ec_observed_constraint_norm(constraint_low,origin_fields,low,low,control)
+    max(cl.electric,cl.magnetic)<=1 || _ec_reject(:field_constraint,:low,0,0,max(cl.electric,cl.magnetic))
+    continuity_low=_ec_continuity(low,h,meter)
+    force1=_ec_force!(low,low_species,mobile,H,meter)
+    raw1=_ec_current!(low,low_species,mobile,meter)
+    derivatives1=_ec_derivatives!(low,meter)
+    # Gathering/current scratch cannot replace the low branch's consumed current.
+    low_snapshot=_ec_snapshot(low,low_species)
+    if low isa EMPIC
+        foreach(copyto!,low.Jraw,raw0.current)
+        low_snapshot=merge(low_snapshot,(fields=merge(low_snapshot.fields,(Jraw=map(copy,raw0.current),)),))
+    end
+    high_species=_ec_copy_species(origin_species,Val(D),T)
+    high_lift=_ec_particle_branch!(high_species,origin_species,low_species,force0,force1,stage,mobile,h,:high)
+    rawhigh=_ec_average_current(raw0,raw1,T)
+    copyto!(stage.rho_n,rho0);_ec_source!(stage.rho_np1,stage,high_species,target,meter)
+    _ec_correct!(stage,rawhigh,h,meter,:high)
+    weights=(BigInt(1)//BigInt(2),BigInt(1)//BigInt(2));stages=(derivatives0,derivatives1)
+    _empic_full_time_field_update!(stage,origin_fields,stages,weights,h)
+    all(a -> all(isfinite,a),(_empic_event_E(stage)...,_empic_event_B(stage)...,_empic_event_J(stage)...)) || _ec_reject(:nonfinite_field,:high)
+    constraint_high=_ec_constraint(stage,meter)
+    continuity_high=_ec_continuity(stage,h,meter)
+    lifts=(low=low_lift,high=high_lift)
+    nx,nv=_ec_particle_norm(origin_species,low_species,high_species,lifts,mobile,stage.g,control)
+    E0=_empic_event_field_E(stage,origin_fields);B0=_empic_event_field_B(stage,origin_fields)
+    de=map((a,b) -> map((x,y) -> _exact_rational(x)-_exact_rational(y),a,b),_empic_event_E(stage),_empic_event_E(low))
+    db=map((a,b) -> map((x,y) -> _exact_rational(x)-_exact_rational(y),a,b),_empic_event_B(stage),_empic_event_B(low))
+    ne=_ec_field_norm(de,E0,_empic_event_E(low),_empic_event_E(stage),control,:E)
+    nb=_ec_field_norm(db,B0,_empic_event_B(low),_empic_event_B(stage),control,:B)
+    scale=_exact_rational(control.atol.clock)+_exact_rational(control.rtol.clock)*max(abs(_exact_rational(time)),abs(_exact_rational(next_time)),abs(source),abs(source+delta))
+    duration_defect=H-delta;addition_defect=_exact_rational(next_time)-_exact_rational(time)-H
+    nc=max(abs(duration_defect),abs(addition_defect),abs(duration_defect+addition_defect))/scale
+    ch=_ec_observed_constraint_norm(constraint_high,origin_fields,low,stage,control)
+    norms=(x=nx,v=nv,E=ne,B=nb,clock=nc,constraint_E_low=cl.electric,constraint_B_low=cl.magnetic,constraint_E_high=ch.electric,constraint_B_high=ch.magnetic)
+    norm=maximum(values(norms));norm<=1 || _ec_reject(:embedded_defect,:pair,0,0,norm)
+    work=_ec_interval_work(stage,origin_species,low_species,high_species,origin_fields,force0,force1,rawhigh,h,mobile)
+    interval=(dt=h,source_before=source,source_after=source+delta,elapsed_before=elapsed,elapsed_after=elapsed+H,
+        public_before=time,public_after=next_time,duration_defect=duration_defect,addition_defect=addition_defect,
+        origin=(species=NamedTuple[deepcopy(_checkpoint_particle_state(ps)) for ps in origin_species],fields=_ec_copy_fields(origin_fields)),
+        low=low_snapshot,high=_ec_snapshot(stage,high_species),
+        stage0=(forces=force0,raw=raw0,derivatives=derivatives0,stencil=[_ec_stencil_receipt(ps,stage.g,stage.shape) for ps in origin_species]),
+        stage1=(forces=force1,raw=raw1,derivatives=derivatives1,stencil=[_ec_stencil_receipt(ps,stage.g,stage.shape) for ps in low_species]),
+        raw_effective=rawhigh,lifts=lifts,norms=norms,norm=norm,constraint_low=constraint_low,constraint_high=constraint_high,
+        continuity=(low=continuity_low,high=continuity_high),
+        rows=(low=_ec_row_receipts(origin_fields,low,(derivatives0,),(one(_EMPICCoupledQ),),h),high=_ec_row_receipts(origin_fields,stage,stages,weights,h)),
+        work=work,costs=_ec_cost_sub(_ec_costs(meter),before_cost))
+    return high_species,interval
+end
+function _ec_role_arrays(value,result=AbstractArray[],descended=IdDict{Any,Bool}();depth=0)
+    depth<=32 || throw(ArgumentError("coupled closed receipt exceeds its schema nesting bound"))
+    if value isa AbstractArray
+        push!(result,value)
+        # Repeated roles remain visible to independence checks, but a cycle
+        # must not recursively enumerate the same container forever.
+        haskey(descended,value) && return result
+        descended[value]=true
+        if !(eltype(value)<:Number)
+            for entry in value
+                _ec_role_arrays(entry,result,descended;depth=depth+1)
+            end
+        end
+    elseif value isa NamedTuple || value isa Tuple
+        for entry in value
+            _ec_role_arrays(entry,result,descended;depth=depth+1)
+        end
+    elseif value isa ParticleSet
+        append!(result,_empic_event_arrays(value))
+    end
+    return result
+end
+function _ec_independent(arrays)
+    for (i,a) in enumerate(arrays),j=1:i-1
+        b=arrays[j]
+        left,right=_checkpoint_packed_chunks(a),_checkpoint_packed_chunks(b)
+        (_particle_arrays_mightalias(a,b) ||
+            (left!==nothing && _particle_arrays_mightalias(left,b)) ||
+            (right!==nothing && _particle_arrays_mightalias(a,right)) ||
+            (left!==nothing && right!==nothing && _particle_arrays_mightalias(left,right))) &&
+            throw(ArgumentError("coupled particle/field/controller/report storage roles overlap"))
+    end
+    return nothing
+end
+function _ec_report_cells(value)
+    count=0
