+    expected_cost=merge(expected_cost,(force_evals=Base.checked_add(expected_cost.force_evals,decision_force),report_cells=r.costs.report_cells))
+    expected_cost==r.costs || throw(ArgumentError("coupled operation counters omit actual admission/verification/trial/decision work"))
