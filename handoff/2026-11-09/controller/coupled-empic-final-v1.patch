+        max(observed.electric,observed.magnetic)<=1 || throw(ArgumentError("coupled ending field constraint differs"))
+        phase.report===nothing || _ec_report_check(es,phase,species,fields,clock,meter;replay)
+    end
+    return nothing
+end
+function _empic_collection_validate_species_history(es,schedule::_EMPICCoupledSchedule)
+    # Public controlled operations own the full observed/replayed admission.
+    count=es.collection.initialized[] ? length(es.collection.owners) : length(es.collection.mobile)
+    _ec_phase_scalar_check(es,schedule.phase,count,es.collection.initialized[],
+        (es.time[],es.step[],es.last_dt[],es.last_sub_dt[]))
+    es.collection.initialized[] && _ec_shadow_matches(es,schedule)
+    return nothing
+end
+function _ec_ready(es,species,meter)
