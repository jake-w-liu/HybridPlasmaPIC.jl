+            all(_particle_stored_zero,phase.interval) && all(iszero,(phase.last...,phase.next...)) &&
+            all(iszero,(phase.field_defect,phase.particle_defect,phase.coupling_defect)) || throw(ArgumentError("coupled step-zero phase is advanced"))
