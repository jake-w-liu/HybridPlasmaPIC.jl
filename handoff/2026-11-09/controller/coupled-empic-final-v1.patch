+    return nothing
+end
+function _ec_validate_phase(es,phase,species,fields,initialized,clock,meter;replay=true)
+    _ec_phase_scalar_check(es,phase,length(species),initialized,clock)
+    if initialized
+        if iszero(clock[2])
+            currents=es isa EMPIC ? (fields.J...,fields.Jraw...) : (fields.Jx,fields.Jy)
+            _ec_identical(fields.rho_n,fields.rho_np1) &&
+                all(array -> all(_particle_stored_zero,array),currents) ||
+                throw(ArgumentError("initialized coupled step-zero source/current inventory differs from full-time initialization"))
+        end
+        probe=_ec_new_stage(es);_ec_restore_fields!(probe,fields)
+        K,U=_ec_energy(probe,species)
+        K+U-phase.initial_energy==phase.field_defect+phase.particle_defect+phase.coupling_defect || throw(ArgumentError("coupled cumulative measured-energy ledger differs"))
+        charges=_pic_collection_charges(es.g,es.n0,species)
+        target=_empic_collection_charge_target(es,es.collection,charges)
+        rho=similar(probe.rho_np1);_ec_source!(rho,probe,species,target,meter)
+        isequal(rho,fields.rho_np1) || throw(ArgumentError("coupled ending charge/source differs"))
