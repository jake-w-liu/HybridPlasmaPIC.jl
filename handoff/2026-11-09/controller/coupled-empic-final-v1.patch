+    trial_cost=_ec_zero_costs();decision_force=0
+    previous_high=nothing
+    probe=_ec_new_stage(es)
+    reasons=(:nonfinite_gather,:nonfinite_derivative,:nonfinite_velocity,:unsupported_velocity,:travel,
+        :ambiguous_position,:nonfinite_current,:nonfinite_field,:field_constraint,:unresolved_continuity,:embedded_defect)
+    for interval in r.intervals
+        interval isa NamedTuple && keys(interval)==_EC_INTERVAL_KEYS || throw(ArgumentError("coupled interval fields differ"))
+        before=_ec_snapshot_check(es,interval.origin)
+        _ec_snapshot_check(es,interval.low);_ec_snapshot_check(es,interval.high)
+        previous_high===nothing || isequal(previous_high,interval.origin) || throw(ArgumentError("coupled accepted physical history is discontinuous"))
+        interval.source_before==source && interval.elapsed_before==elapsed && isequal(interval.public_before,clock_value) || throw(ArgumentError("coupled interval origins differ"))
+        for i in eachindex(es.collection.mobile)
+            es.collection.mobile[i] || continue
+            bootstrap=r.step_before==0 && source==r.start && iszero(H[i])
+            if bootstrap || b[i]==source
+                dcursor<=length(r.decisions) || throw(ArgumentError("coupled report omitted a due nominal decision"))
+                decision=r.decisions[dcursor]
+                keys(decision)==(:species,:time,:previous,:bootstrap,:selected,:cap,:upper,:minimum,:adaptive,:limits,:q,:m,:E1,:B1,:V1,:halvings) &&
+                    decision.species==i && decision.time==source && isequal(decision.previous,H[i]) && decision.bootstrap===bootstrap || throw(ArgumentError("coupled nominal decision ordering differs"))
+                sample=interval.stage0.forces[i]
+                sample===nothing && throw(ArgumentError("coupled nominal decision has no actual force-stage sample"))
+                _ec_install_samples!(probe,before[i],sample)
+                choice=_empic_event_interval_choice(probe,p,before[i],i,H[i],bootstrap)
+                expected=merge((species=i,time=source,previous=H[i],bootstrap=bootstrap),choice)
+                _ec_identical(decision,expected) || throw(ArgumentError("coupled nominal decision differs from canonical sampled policy"))
+                decision_force=Base.checked_add(decision_force,nparticles(before[i]))
+                H[i],a[i],b[i]=decision.selected,source,source+_exact_rational(decision.selected)
+                dcursor+=1
+            end
+        end
+        edge,base=_empic_event_next((time=r.start,next=b),es.collection.mobile,source,r.finish,base,r.n_sub)
+        delta=min(_exact_rational(hint),edge-source)
+        while rcursor<=length(r.rejections) && r.rejections[rcursor].source==source
+            rejected=r.rejections[rcursor]
+            keys(rejected)==(:dt,:source,:delta,:clock_value,:reason,:stage,:species,:particle,:defect,:costs) &&
+                rejected.dt isa T && r.control.h_min<=rejected.dt<=r.control.h_max && rejected.delta==delta &&
+                isequal(rejected.dt,_empic_event_interval(T,delta)) && isequal(rejected.clock_value,clock_value) &&
+                rejected.reason in reasons && rejected.stage isa Symbol && rejected.species isa Int && rejected.particle isa Int &&
+                rejected.species>=0 && rejected.particle>=0 && (rejected.defect===nothing || _ec_q(rejected.defect)) || throw(ArgumentError("coupled rejected-trial receipt differs"))
+            _ec_costs_check(rejected.costs);rejected.costs.trials==1 && rejected.costs.report_cells==0 || throw(ArgumentError("coupled rejected-trial counters differ"))
+            rejected.reason in (:embedded_defect,:field_constraint) && !(rejected.defect!==nothing && rejected.defect>1) && throw(ArgumentError("coupled rejection has no failed measured defect"))
+            rejected.reason===:travel && !(rejected.defect!==nothing && rejected.defect>=1) && throw(ArgumentError("coupled travel rejection has no failed travel ratio"))
+            trial_cost=_ec_cost_add(trial_cost,rejected.costs)
+            delta/=2;rcursor+=1
+        end
+        delta>=_exact_rational(r.control.h_min) && interval.source_after==source+delta && interval.dt isa T &&
+            isequal(interval.dt,_empic_event_interval(T,delta)) && r.control.h_min<=interval.dt<=r.control.h_max &&
+            interval.norm isa _EMPICCoupledQ && 0<=interval.norm<=1 && interval.norm==maximum(values(interval.norms)) || throw(ArgumentError("coupled accepted trial/halving/defect differs"))
+        next_clock,_=_validated_step_clock(clock_value,r.step_before,interval.dt)
+        isequal(next_clock,interval.public_after) && next_clock>clock_value &&
+            interval.duration_defect==_exact_rational(interval.dt)-delta &&
+            interval.addition_defect==_exact_rational(next_clock)-_exact_rational(clock_value)-_exact_rational(interval.dt) &&
+            interval.elapsed_after==elapsed+_exact_rational(interval.dt) || throw(ArgumentError("coupled actual interval clock/materialization differs"))
+        _ec_costs_check(interval.costs);interval.costs.trials==1 && interval.costs.report_cells==0 || throw(ArgumentError("coupled accepted-trial work counters differ"))
+        if replay
+            charges=_pic_collection_charges(es.g,es.n0,before)
+            target=_empic_collection_charge_target(es,es.collection,charges)
+            fresh=try
+                _,packet=_ec_pair!(probe,before,interval.origin.fields,es.collection.mobile,target,interval.dt,delta,clock_value,next_clock,source,elapsed,r.control,meter)
+                packet
+            catch failure
+                failure isa _EMPICCoupledReject || rethrow()
+                throw(ArgumentError("saved coupled accepted trial now fails its own historical admission: $(failure.reason)"))
+            end
+            _ec_identical(interval,fresh) || throw(ArgumentError("coupled accepted trial differs from canonical source/force/field/rounding replay"))
+        end
+        trial_cost=_ec_cost_add(trial_cost,interval.costs)
+        source,elapsed,clock_value=source+delta,interval.elapsed_after,next_clock
+        hint=_ec_recommend(interval.dt,interval.norm,r.control)
+        previous_high=interval.high
+    end
+    dcursor==length(r.decisions)+1 && rcursor==length(r.rejections)+1 && source==r.finish && elapsed==r.elapsed_after &&
+        isequal(clock_value,r.public_after) && isequal(last(r.intervals).dt,fast) && H==phase.interval && a==phase.last && b==phase.next || throw(ArgumentError("coupled final clock/calendar/retry history differs"))
+    previous_high!==nothing && isequal(previous_high.fields,fields) || throw(ArgumentError("coupled report ending physical fields differ"))
+    _ec_species_records_equal(previous_high.species,species) || throw(ArgumentError("coupled report ending particles differ"))
